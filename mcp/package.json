{
  "name": "engramd",
  "version": "1.0.2",
  "description": "MCP server for Engram — self-hostable AI memory layer. Search, add, update, and capture memories from any MCP client.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "engramd": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "homepage": "https://engram.ayushh.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macayu17/engram.git",
    "directory": "mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memory",
    "ai",
    "engram",
    "claude"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "verify:defaults": "npm run build && node ../scripts/verify_mcp_tool_defaults.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0"
  }
}
